# Keep host-driven program selection from publishing the factory values back
# as new edits. Renoise queues those edits and can replay them after restoring
# the project's complete state. Keep the explicit Program notification, so
# host and editor program selectors remain aligned. The shared JUCE checkout
# stays unchanged.
function(kb09_guard_vst3_program_changes)
    set(wrapper "${JUCE_DIR}/modules/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp")
    file(READ "${wrapper}" original)
    set(before "            const auto programValue = getProgramValueFromNormalised (v);")
    set(after "            const ScopedValueSetter<bool> hostProgramChange { kb09InHostProgramChange, true };\n${before}")
    string(FIND "${original}" "${before}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "JUCE VST3 program callback changed; review the KB-09 host-echo guard.")
    endif()
    string(REPLACE "${before}" "${after}" guarded "${original}")
    set(flag "static thread_local bool inParameterChangedCallback = false;")
    set(callback "        if (inParameterChangedCallback || inSetState)\n            return;")
    foreach(anchor IN ITEMS "${flag}" "${callback}")
        string(FIND "${original}" "${anchor}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "JUCE VST3 parameter callback changed; review the KB-09 host-echo guard.")
        endif()
    endforeach()
    string(REPLACE "${flag}" "${flag}\nstatic thread_local bool kb09InHostProgramChange = false;" guarded "${guarded}")
    string(REPLACE "${callback}"
        "${callback}\n\n        if (kb09InHostProgramChange && vstParamId != audioProcessor->getProgramParamID())\n        {\n            EditController::setParamNormalized (vstParamId, newValue);\n            return;\n        }"
        guarded "${guarded}")
    set(output_dir "${CMAKE_CURRENT_BINARY_DIR}/kb09_vst3")
    file(MAKE_DIRECTORY "${output_dir}")
    file(CONFIGURE OUTPUT "${output_dir}/juce_audio_plugin_client_VST3.cpp" CONTENT "${guarded}" @ONLY)
    file(CONFIGURE OUTPUT "${output_dir}/juce_audio_plugin_client_VST3.mm"
        CONTENT "#include \"juce_audio_plugin_client_VST3.cpp\"\n" @ONLY)
    get_target_property(wrapper_sources juce_audio_plugin_client_VST3 INTERFACE_SOURCES)
    set(replaced FALSE)
    set(guarded_sources)
    foreach(source IN LISTS wrapper_sources)
        if(source MATCHES "/juce_audio_plugin_client_VST3\\.(cpp|mm)$")
            get_filename_component(filename "${source}" NAME)
            list(APPEND guarded_sources "${output_dir}/${filename}")
            set(replaced TRUE)
        else()
            list(APPEND guarded_sources "${source}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "JUCE VST3 wrapper target changed; cannot install the KB-09 host-echo guard.")
    endif()
    set_property(TARGET juce_audio_plugin_client_VST3 PROPERTY INTERFACE_SOURCES "${guarded_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wrapper}")
endfunction()
